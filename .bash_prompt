#!/usr/bin/env bash

# Shell prompt based on the Solarized Dark theme.
# Screenshot: http://i.imgur.com/EkEtphC.png
# Heavily inspired by @necolas’s prompt: https://github.com/necolas/dotfiles
# iTerm → Profiles → Text → use 13pt Monaco with 1.1 vertical spacing.

if [[ $COLORTERM = gnome-* && $TERM = xterm ]] && infocmp gnome-256color >/dev/null 2>&1; then
	export TERM='gnome-256color';
elif infocmp xterm-256color >/dev/null 2>&1; then
	export TERM='xterm-256color';
fi;

# The dirty-state checks in prompt_git cost one filesystem round-trip per
# tracked file. On a local disk that is ~0.1s for a 6k-file repo and nobody
# notices; on a network mount every stat is a network round-trip, which put a
# 6k-file repo under /Volumes at ~9s of lag on *every* prompt. `git
# update-index --really-refresh` was the bulk of it: "really" means discard
# cached stat info and re-stat unconditionally, so the result can never be
# served from the SMB attribute cache.
#
# Pure bash string match, no subprocess and no stat, so repos on local disk
# pay literally nothing for this check and keep their full flags.
prompt_git_slow_fs() {
	case "${PWD}" in
		/Volumes/*|/net/*) return 0 ;;
	esac
	return 1
}

# Prints "<branch> <flags>" on one line, or nothing outside a Git repository.
# Only ever run through prompt_git, which puts a time limit on it.
prompt_git_state() {
	local s='';
	local branchName='';

	# Check if the current directory is in a Git repository.
	if [ $(git rev-parse --is-inside-work-tree &>/dev/null; echo "${?}") == '0' ]; then

		# check if the current directory is in .git before running git checks
		if [ "$(git rev-parse --is-inside-git-dir 2> /dev/null)" == 'false' ] && ! prompt_git_slow_fs; then

			# Ensure the index is up to date.
			git update-index --really-refresh -q &>/dev/null;

			# Check for uncommitted changes in the index.
			if ! $(git diff --quiet --ignore-submodules --cached); then
				s+='+';
			fi;

			# Check for unstaged changes.
			if ! $(git diff-files --quiet --ignore-submodules --); then
				s+='!';
			fi;

			# Check for untracked files.
			if [ -n "$(git ls-files --others --exclude-standard)" ]; then
				s+='?';
			fi;

			# Check for stashed files.
			if $(git rev-parse --verify refs/stash &>/dev/null); then
				s+='$';
			fi;

		fi;

		# Get the short symbolic ref.
		# If HEAD isn’t a symbolic ref, get the short SHA for the latest commit
		# Otherwise, just give up.
		branchName="$(git symbolic-ref --quiet --short HEAD 2> /dev/null || \
			git rev-parse --short HEAD 2> /dev/null || \
			echo '(unknown)')";

		# On a slow fs the flags above were never computed, so an empty `s` does
		# NOT mean clean. Mark the state unknown instead — a dirty repo that
		# renders as clean is worse than a slow prompt. `~` is deliberately
		# distinct from the four real flags (+ ! ? $).
		if prompt_git_slow_fs; then
			s='~';
		fi;

		printf '%s %s\n' "${branchName}" "${s}";
	fi;
}

# Any git command can block indefinitely when the repo lives in iCloud Drive
# and files under .git are evicted ("dataless"): reading one makes the kernel
# wait for iCloud to download it, and that wait ignores Ctrl+C. Since PS1 runs
# this on every prompt, the shell would sit there with no way out.
#
# So the git work runs in a background process substitution and we give it one
# second. On timeout we print N/A wherever git state would go and leave the
# probe behind; we never wait on it, because it can't be interrupted anyway.
prompt_git() {
	local branchName='';
	local s='';
	local status;

	IFS=' ' read -r -t 1 branchName s < <(prompt_git_state);
	status="${?}";

	if [ "${status}" -gt 128 ]; then
		# Stop the probe from starting more git commands. One already blocked on
		# iCloud exits when its read returns, releasing any index.lock it holds.
		kill "${!}" 2>/dev/null;
		branchName='N/A';
		s='N/A';
	elif [ -z "${branchName}" ]; then
		return;
	fi;

	[ -n "${s}" ] && s=" [${s}]";
	echo -e "${1}${branchName}${2}${s}";
}

if tput setaf 1 &> /dev/null; then
	tput sgr0; # reset colors
	bold=$(tput bold);
	reset=$(tput sgr0);
	# Solarized colors, taken from http://git.io/solarized-colors.
	black=$(tput setaf 0);
	blue=$(tput setaf 33);
	cyan=$(tput setaf 37);
	green=$(tput setaf 64);
	orange=$(tput setaf 166);
	purple=$(tput setaf 125);
	red=$(tput setaf 124);
	violet=$(tput setaf 61);
	white=$(tput setaf 15);
	yellow=$(tput setaf 136);
else
	bold='';
	reset="\e[0m";
	black="\e[1;30m";
	blue="\e[1;34m";
	cyan="\e[1;36m";
	green="\e[1;32m";
	orange="\e[1;33m";
	purple="\e[1;35m";
	red="\e[1;31m";
	violet="\e[1;35m";
	white="\e[1;37m";
	yellow="\e[1;33m";
fi;

# Highlight the user name when logged in as root.
if [[ "${USER}" == "root" ]]; then
	userStyle="${red}";
else
	userStyle="${orange}";
fi;

# Highlight the hostname when connected via SSH.
if [[ "${SSH_TTY}" ]]; then
	hostStyle="${bold}${red}";
else
	hostStyle="${yellow}";
fi;

# Set the terminal title and prompt.
PS1="\[\033]0;\W\007\]"; # working directory base name
PS1+="\[${bold}\]\n"; # newline
PS1+="\[${userStyle}\]\u"; # username
PS1+="\[${white}\] at ";
# PS1+="\[${hostStyle}\]\h"; # host
PS1+="\[${hostStyle}\]$(scutil --get LocalHostName)"; # host for OSX

PS1+="\[${white}\] in ";
PS1+="\[${green}\]\w"; # working directory full path
PS1+="\$(prompt_git \"\[${white}\] on \[${violet}\]\" \"\[${blue}\]\")"; # Git repository details
PS1+="\n";
PS1+="\[${white}\]\$ \[${reset}\]"; # `$` (and reset color)
export PS1;

PS2="\[${yellow}\]→ \[${reset}\]";
export PS2;
