#!/usr/bin/env bash

function getblock() {
  local block_number=${1}
  local encoding=${2:-json}
  curl $QUICKNODE_RPC -X POST -H "Content-Type: application/json" \
    --data "{\"jsonrpc\": \"2.0\",\"id\":1,\"method\":\"getBlock\",\"params\":[${block_number}, {\"encoding\": \"${encoding}\",\"maxSupportedTransactionVersion\":0,\"transactionDetails\":\"full\"}]}"
}

function gettx() {
  local tx_id=${1}
  local encoding=${2:-json}
  curl $QUICKNODE_RPC -X POST -H "Content-Type: application/json" \
    --data "{\"jsonrpc\": \"2.0\",\"id\":1,\"method\":\"getTransaction\",\"params\":[\"${tx_id}\", {\"encoding\": \"${encoding}\",\"maxSupportedTransactionVersion\":0}]}"
}

# Used for decoding binary addresses and transaction hashes when stored
# as binary in the database.
function dbdecode() {
  local hash_value=${1}
  if [ -z "$hash_value" ]; then
    echo "Usage: decodedb <hash_value>"
    return 1
  fi
  # Check if bs58 is installed globally
  if ! npm list -g bs58 >/dev/null 2>&1; then
    echo "Installing bs58 globally..."
    npm install -g bs58
  fi
  # Get the global node_modules path
  local global_modules=$(npm root -g)
  # Export NODE_PATH to ensure it's available to the node process
  export NODE_PATH="$global_modules"

  node -e "
    const {default: bs58} = require('bs58');
    const hexString = '${hash_value}';
    const buffer = Buffer.from(hexString, 'hex');
    console.log(bs58.encode(buffer));
  "
}

# Used for encoding binary addresses and transaction hashes when stored
# as binary in the database.
function dbencode() {
  local address=${1}
  if [ -z "$address" ]; then
    echo "Usage: dbencode <address>"
    return 1
  fi
  # Check if bs58 is installed globally
  if ! npm list -g bs58 >/dev/null 2>&1; then
    echo "Installing bs58 globally..."
    npm install -g bs58
  fi
  # Check if @solana/web3.js is installed globally
  if ! npm list -g @solana/web3.js >/dev/null 2>&1; then
    echo "Installing @solana/web3.js globally..."
    npm install -g @solana/web3.js
  fi

  # Get the global node_modules path
  local global_modules=$(npm root -g)
  # Export NODE_PATH to ensure it's available to the node process
  export NODE_PATH="$global_modules"

  node -e "
    const {default: bs58} = require('bs58');
    const { PublicKey } = require('@solana/web3.js');
    const address = '${address}';

    const pubkey = new PublicKey(address);
    const buffer = Buffer.from(pubkey.toBytes()).toString('hex');
    console.log(buffer);
  "
}

# Create a new directory and enter it
function mkd() {
	mkdir -p "$@" && cd "$_";
}

# Change working directory to the top-most Finder window location
function cdf() { # short for `cdfinder`
	cd "$(osascript -e 'tell app "Finder" to POSIX path of (insertion location as alias)')";
}

# Create a .tar.gz archive, using `zopfli`, `pigz` or `gzip` for compression
function targz() {
	local tmpFile="${@%/}.tar";
	tar -cvf "${tmpFile}" --exclude=".DS_Store" "${@}" || return 1;

	size=$(
		stat -f"%z" "${tmpFile}" 2> /dev/null; # macOS `stat`
		stat -c"%s" "${tmpFile}" 2> /dev/null;  # GNU `stat`
	);

	local cmd="";
	if (( size < 52428800 )) && hash zopfli 2> /dev/null; then
		# the .tar file is smaller than 50 MB and Zopfli is available; use it
		cmd="zopfli";
	else
		if hash pigz 2> /dev/null; then
			cmd="pigz";
		else
			cmd="gzip";
		fi;
	fi;

	echo "Compressing .tar ($((size / 1000)) kB) using \`${cmd}\`…";
	"${cmd}" -v "${tmpFile}" || return 1;
	[ -f "${tmpFile}" ] && rm "${tmpFile}";

	zippedSize=$(
		stat -f"%z" "${tmpFile}.gz" 2> /dev/null; # macOS `stat`
		stat -c"%s" "${tmpFile}.gz" 2> /dev/null; # GNU `stat`
	);

	echo "${tmpFile}.gz ($((zippedSize / 1000)) kB) created successfully.";
}

# Determine size of a file or total size of a directory
function fs() {
	if du -b /dev/null > /dev/null 2>&1; then
		local arg=-sbh;
	else
		local arg=-sh;
	fi
	if [[ -n "$@" ]]; then
		du $arg -- "$@";
	else
		du $arg .[^.]* ./*;
	fi;
}

# Use Git's colored diff when available
hash git &>/dev/null;
if [ $? -eq 0 ]; then
	function diff() {
		git diff --no-index --color-words "$@";
	}
fi;

# Create a data URL from a file
function dataurl() {
	local mimeType=$(file -b --mime-type "$1");
	if [[ $mimeType == text/* ]]; then
		mimeType="${mimeType};charset=utf-8";
	fi
	echo "data:${mimeType};base64,$(openssl base64 -in "$1" | tr -d '\n')";
}

# Start an HTTP server from a directory, optionally specifying the port
function server() {
	local port="${1:-8000}";
	sleep 1 && open "http://localhost:${port}/" &
	# Set the default Content-Type to `text/plain` instead of `application/octet-stream`
	# And serve everything as UTF-8 (although not technically correct, this doesn't break anything for binary files)
	python -c $'import SimpleHTTPServer;\nmap = SimpleHTTPServer.SimpleHTTPRequestHandler.extensions_map;\nmap[""] = "text/plain";\nfor key, value in map.items():\n\tmap[key] = value + ";charset=UTF-8";\nSimpleHTTPServer.test();' "$port";
}

# Start a PHP server from a directory, optionally specifying the port
# (Requires PHP 5.4.0+.)
function phpserver() {
	local port="${1:-4000}";
	local ip=$(ipconfig getifaddr en1);
	sleep 1 && open "http://${ip}:${port}/" &
	php -S "${ip}:${port}";
}

# Compare original and gzipped file size
function gz() {
	local origsize=$(wc -c < "$1");
	local gzipsize=$(gzip -c "$1" | wc -c);
	local ratio=$(echo "$gzipsize * 100 / $origsize" | bc -l);
	printf "orig: %d bytes\n" "$origsize";
	printf "gzip: %d bytes (%2.2f%%)\n" "$gzipsize" "$ratio";
}

# Run `dig` and display the most useful info
function digga() {
	dig +nocmd "$1" any +multiline +noall +answer;
}

# Show all the names (CNs and SANs) listed in the SSL certificate
# for a given domain
function getcertnames() {
	if [ -z "${1}" ]; then
		echo "ERROR: No domain specified.";
		return 1;
	fi;

	local domain="${1}";
	echo "Testing ${domain}…";
	echo ""; # newline

	local tmp=$(echo -e "GET / HTTP/1.0\nEOT" \
		| openssl s_client -connect "${domain}:443" -servername "${domain}" 2>&1);

	if [[ "${tmp}" = *"-----BEGIN CERTIFICATE-----"* ]]; then
		local certText=$(echo "${tmp}" \
			| openssl x509 -text -certopt "no_aux, no_header, no_issuer, no_pubkey, \
			no_serial, no_sigdump, no_signame, no_validity, no_version");
		echo "Common Name:";
		echo ""; # newline
		echo "${certText}" | grep "Subject:" | sed -e "s/^.*CN=//" | sed -e "s/\/emailAddress=.*//";
		echo ""; # newline
		echo "Subject Alternative Name(s):";
		echo ""; # newline
		echo "${certText}" | grep -A 1 "Subject Alternative Name:" \
			| sed -e "2s/DNS://g" -e "s/ //g" | tr "," "\n" | tail -n +2;
		return 0;
	else
		echo "ERROR: Certificate not found.";
		return 1;
	fi;
}

# Normalize `open` across Linux, macOS, and Windows.
# This is needed to make the `o` function (see below) cross-platform.
if [ ! $(uname -s) = 'Darwin' ]; then
	if grep -q Microsoft /proc/version; then
		# Ubuntu on Windows using the Linux subsystem
		alias open='explorer.exe';
	else
		alias open='xdg-open';
	fi
fi

# `o` with no arguments opens the current directory, otherwise opens the given
# location
function o() {
	if [ $# -eq 0 ]; then
		open .;
	else
		open "$@";
	fi;
}

# `tre` is a shorthand for `tree` with hidden files and color enabled, ignoring
# the `.git` directory, listing directories first. The output gets piped into
# `less` with options to preserve color and line numbers, unless the output is
# small enough for one screen.
function tre() {
	tree -aC -I '.git|node_modules|bower_components' --dirsfirst "$@" | less -FRNX;
}

# Transcribe audio or video files using whisper.cpp
function transcribe() {
  local input_file=${1}
  local output_file=${2:-output}

  if [ -z "$input_file" ]; then
    echo "Usage: transcribe <input_file> [output_file]"
    return 1
  fi

  whisper-cli \
    -m ~/tiktok/whisper-models/ggml-medium.bin \
    -f "$input_file" \
    -l el \
    -t 8 \
    -osrt \
    -of "$output_file"
}

# Extract audio from video file using ffmpeg
function extract_audio() {
  local input_video="${1}"
  local output_audio="${2:-output_audio.wav}"

  if [ -z "$input_video" ]; then
    echo "❗ Usage: extract_audio <video_file> [output_audio]"
    return 1
  fi

  echo "🎧 Extracting audio from video..."

  ffmpeg -y -i "${input_video}" \
    -ar 16000 -ac 1 -acodec pcm_s16le "${output_audio}"

  if [ $? -ne 0 ]; then
    echo "💥 Failed to extract audio."
    return 1
  fi

  echo "✅ Audio extracted successfully: ${output_audio}"
}


# Transcribe any video file by extracting audio first (debug-friendly)
function transcribe_vid() {
  local input_video="${1}"
  local output_base="${2:-output}"

  if [ -z "$input_video" ]; then
    echo "❗ Usage: transcribe_vid <video_file> [output_base]"
    return 1
  fi

  # Use only the filename part of output_base for /tmp audio
  local output_stem
  output_stem="$(basename "${output_base}")"
  local tmp_audio="/tmp/${output_stem}_audio.wav"

  # Ensure the output directory (if any) exists for the .srt
  local out_dir
  out_dir="$(dirname "${output_base}")"
  if [ "${out_dir}" != "." ]; then
    echo "📁 Ensuring output directory exists: ${out_dir}"
    mkdir -p "${out_dir}" || { echo "💥 Failed to create output directory."; return 1; }
  fi

  echo "🎬 Input video: ${input_video}"
  echo "🎯 Output base: ${output_base}"
  echo "🗂  Temp audio: ${tmp_audio}"
  echo "---------------------------"

  # Step 1: Extract audio (show full command + logs) - use extract_audio function
  extract_audio "${input_video}" "${tmp_audio}"

  if [ $? -ne 0 ]; then
    echo "💥 Failed to extract audio."
    return 1
  fi
  echo "✅ Audio extracted: ${tmp_audio}"

  # Step 2: Transcribe using whisper.cpp wrapper
  echo "🧠 Transcribing with Whisper..."
  transcribe "${tmp_audio}" "${output_base}"
  if [ $? -ne 0 ]; then
    echo "💥 Transcription failed."
    rm -f "${tmp_audio}"
    return 1
  fi
  echo "✅ Transcription complete: ${output_base}.srt"

  # Step 3: Clean up
  echo "🧹 Cleaning up temporary audio..."
  rm -f "${tmp_audio}" && echo "✅ Done!"
}

# Transcribe audio or video files using whisper.cpp (English)
function transcribe_en() {
  local input_file=${1}
  local output_file=${2:-output}

  if [ -z "$input_file" ]; then
    echo "Usage: transcribe_en <input_file> [output_file]"
    return 1
  fi

  whisper-cli \
    -m ~/tiktok/whisper-models/ggml-medium.bin \
    -f "$input_file" \
    -l en \
    -t 8 \
    -osrt \
    -of "$output_file"
}

# Transcribe any video file by extracting audio first (English)
function transcribe_vid_en() {
  local input_video="${1}"
  local output_base="${2:-output}"

  if [ -z "$input_video" ]; then
    echo "❗ Usage: transcribe_vid_en <video_file> [output_base]"
    return 1
  fi

  local output_stem
  output_stem="$(basename "${output_base}")"
  local tmp_audio="/tmp/${output_stem}_audio.wav"

  local out_dir
  out_dir="$(dirname "${output_base}")"
  if [ "${out_dir}" != "." ]; then
    echo "📁 Ensuring output directory exists: ${out_dir}"
    mkdir -p "${out_dir}" || { echo "💥 Failed to create output directory."; return 1; }
  fi

  echo "🎬 Input video: ${input_video}"
  echo "🎯 Output base: ${output_base}"
  echo "🗂  Temp audio: ${tmp_audio}"
  echo "---------------------------"

  extract_audio "${input_video}" "${tmp_audio}"
  if [ $? -ne 0 ]; then
    echo "💥 Failed to extract audio."
    return 1
  fi
  echo "✅ Audio extracted: ${tmp_audio}"

  echo "🧠 Transcribing with Whisper (English)..."
  transcribe_en "${tmp_audio}" "${output_base}"
  if [ $? -ne 0 ]; then
    echo "💥 Transcription failed."
    rm -f "${tmp_audio}"
    return 1
  fi
  echo "✅ Transcription complete: ${output_base}.srt"

  echo "🧹 Cleaning up temporary audio..."
  rm -f "${tmp_audio}" && echo "✅ Done!"
}


function transcribe_batchshow_usage() {
    echo "Usage: transcribe_batch"
    echo "Reads a list of video filenames from stdin and transcribes them using transcribe_vid"
    echo "Example: cat video_list.txt | transcribe_batch"
    echo
    echo "Options:"
    echo "  -h    Show this help message"
}

function transcribe_batch() {
    # Handle command line arguments
    if [[ "$1" == "-h" ]]; then
        transcribe_batchshow_usage
        return 0
    fi

    # Check if stdin is empty
    if [ ! -t 0 ]; then
        while IFS= read -r line; do
            # Skip empty lines
            [ -z "$line" ] && continue

            # Get filename without extension
            filename_no_ext="${line%.*}"

            # Escape the input and output paths
            input_path=$(printf "%q" "./$line")
            output_path=$(printf "%q" "../Subtitles/$filename_no_ext")

            # Execute the transcribe command
            eval "transcribe_vid $input_path $output_path"
        done
    else
        transcribe_batchshow_usage
        return 1
    fi
}

# Transcribe MP3 files to subtitles
function transcribe_mp3() {
  local input_audio="${1}"
  local output_base="${2:-output}"

  if [ -z "$input_audio" ]; then
    echo "❗ Usage: transcribe_mp3 <audio_file> [output_base]"
    return 1
  fi

  # Use only the filename part of output_base for /tmp audio
  local output_stem
  output_stem="$(basename "${output_base}")"
  local tmp_audio="/tmp/${output_stem}_converted.wav"
  local duration_seconds

  # Ensure the output directory (if any) exists for the .srt
  local out_dir
  out_dir="$(dirname "${output_base}")"
  if [ "${out_dir}" != "." ]; then
    echo "📁 Ensuring output directory exists: ${out_dir}"
    mkdir -p "${out_dir}" || { echo "💥 Failed to create output directory."; return 1; }
  fi

  echo "🎵 Input audio: ${input_audio}"
  echo "🎯 Output base: ${output_base}"
  echo "---------------------------"

  # Get audio duration in seconds
  duration_seconds=$(ffprobe -i "${input_audio}" -show_entries format=duration -v quiet -of csv="p=0")
  duration_minutes=$(echo "${duration_seconds}/60" | bc)
  echo "📊 Audio duration: ${duration_minutes} minutes"

  # If longer than 10 minutes, split into chunks
  if (( $(echo "${duration_seconds} > 600" | bc -l) )); then
    echo "🔄 Long audio detected, processing in chunks..."

    # Create temporary directory for chunks
    local chunks_dir="/tmp/${output_stem}_chunks"
    mkdir -p "${chunks_dir}"

    # Split audio into 10-minute segments
    ffmpeg -i "${input_audio}" -f segment -segment_time 600 \
      -c copy "${chunks_dir}/chunk_%03d.mp3" >/dev/null 2>&1

    # Process each chunk
    local chunk_count=0
    for chunk in "${chunks_dir}"/chunk_*.mp3; do
      echo "🎵 Processing chunk $((++chunk_count))..."

      # Convert chunk to WAV
      local chunk_wav="${chunks_dir}/chunk_${chunk_count}.wav"
      ffmpeg -y -i "${chunk}" -ar 16000 -ac 1 -acodec pcm_s16le "${chunk_wav}" >/dev/null 2>&1

      # Transcribe chunk
      local chunk_output="${chunks_dir}/chunk_${chunk_count}"
      transcribe "${chunk_wav}" "${chunk_output}"

      # Clean up chunk WAV
      rm -f "${chunk_wav}"
    done

    # Combine all SRT files
    echo "🔄 Combining subtitle chunks..."
    cat "${chunks_dir}"/*.srt > "${output_base}.srt"

    # Clean up
    rm -rf "${chunks_dir}"

  else
    # Convert MP3 to WAV with proper format for Whisper
    echo "🎧 Converting MP3 to WAV..."
    ffmpeg -y -i "${input_audio}" \
      -ar 16000 -ac 1 -acodec pcm_s16le "${tmp_audio}" >/dev/null 2>&1

    if [ $? -ne 0 ]; then
      echo "💥 Failed to convert audio."
      return 1
    fi

    # Transcribe using whisper.cpp wrapper
    echo "🧠 Transcribing with Whisper..."
    transcribe "${tmp_audio}" "${output_base}"
    if [ $? -ne 0 ]; then
      echo "💥 Transcription failed."
      rm -f "${tmp_audio}"
      return 1
    fi

    # Clean up
    rm -f "${tmp_audio}"
  fi

  echo "✅ Transcription complete: ${output_base}.srt"
}


# Re-apply the Claude Code VSCode chat-panel CSS patch (block background on <pre>,
# transparent child backgrounds, comfortable padding). The patch is wiped on every
# extension auto-update (each version installs to its own dir). Idempotent: restores
# from .bak first, then re-appends. Mirrors the `/vsc` Claude Code skill.
function vsc() {
  shopt -s nullglob
  local dirs=(~/.vscode/extensions/anthropic.claude-code-*/)
  if [ ${#dirs[@]} -eq 0 ]; then
    echo "ERROR: anthropic.claude-code extension not found in ~/.vscode/extensions/"
    return 1
  fi
  local ext_dir
  ext_dir=$(printf '%s\n' "${dirs[@]%/}" | sort -V | tail -1)
  local f="${ext_dir}/webview/index.css"
  if [ ! -f "$f" ]; then
    echo "ERROR: webview/index.css not found in ${ext_dir} (layout changed — check the /vsc skill)"
    return 1
  fi
  if [ -f "$f.bak" ]; then cp "$f.bak" "$f"; else cp "$f" "$f.bak"; fi
  cat >> "$f" <<'EOF'

/* claude-code-chat-rendering-patch v1 */
.codeBlockWrapper_-a7MRw pre, pre {background-color: var(--vscode-textCodeBlock-background, var(--vscode-textPreformat-background, rgba(127,127,127,0.15))) !important;}
.codeBlockWrapper_-a7MRw pre code, .codeBlockWrapper_-a7MRw pre code *, pre code, pre code * {background-color: transparent !important; background: transparent !important;}
pre {padding: 8px 12px !important;}
EOF
  echo "Patched: ${f}"
  echo "Backup:  ${f}.bak"
  echo "Reload VSCode: Cmd+Shift+P -> Developer: Reload Window"
}

# Find Claude Code sessions by content across every project, not just $PWD.
# `claude -c` and the /resume picker are scoped to the current directory, so a session
# started in a git worktree (`claude -w`) is invisible from the repo root even though its
# transcript is intact under a separate projects/ key.
# Sorted newest-first: hit count measures how chatty a transcript is, not how relevant it
# is — a worktree path like .../worktrees/STAP-1732 puts the query in nearly every record.
# `claude -r <id>` resolves a session id globally, so resume runs in whatever cwd you are
# in; the printed cwd is only where the session last ran.
# Usage: ccr <query> [-r [N]] [--hits] [--all]
#   -r [N]   resume the Nth listed session (default 1) right here, in $PWD
#   --hits   rank by hit count instead of recency
#   --all    print every match, not just the first 12
function ccr() {
  local query="" resume=0 pick=1 bymtime=1 limit=12 arg
  while [ $# -gt 0 ]; do
    case "$1" in
      -r|--resume)
        resume=1
        if [ -n "$query" ] && [[ "${2:-}" =~ ^[0-9]+$ ]]; then pick="$2"; shift; fi
        ;;
      --hits) bymtime=0 ;;
      --all) limit=100000 ;;
      *) query="$1" ;;
    esac
    shift
  done
  if [ -z "$query" ]; then
    echo "Usage: ccr <query> [-r [N]] [--hits] [--all]"
    return 1
  fi
  if ! command -v jq >/dev/null 2>&1; then
    echo "ERROR: ccr needs jq (brew install jq)"
    return 1
  fi
  local base="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects"
  if [ ! -d "$base" ]; then
    echo "ERROR: no Claude projects dir at ${base}"
    return 1
  fi

  # One jq pass per transcript, emitting tagged records; separate passes over multi-MB
  # files cost more than the awk/grep slicing below.
  local prog='fromjson?
    | (if .type=="custom-title" then (.customTitle // "")
       elif .type=="agent-name" then (.agentName // "")
       elif .type=="ai-title"    then (.aiTitle // "")
       else null end) as $n
    | if $n != null then (if $n=="" then empty else "T\t" + ($n|gsub("[\n\t]";" ")) end)
      elif .type=="user" then
        ("C\t" + (.cwd // "")),
        (if (.isMeta // false) then empty
         else ((.message.content // "")
               | if type=="array" then ([.[] | select(.type=="text") | .text] | join(" "))
                 elif type=="string" then . else "" end
               | gsub("[\n\t]";" ")
               | sub("^ +";"")
               | if .=="" then empty else "U\t" + . end)
         end)
      else empty end'

  local nullglob_was; nullglob_was=$(shopt -p nullglob)
  shopt -s nullglob
  local f id hits title cwd size mtime epoch meta rows=""
  # */*.jsonl deliberately excludes the deeper subagents/ and tool-results/ payloads.
  for f in "$base"/*/*.jsonl; do
    hits=$(grep -ic -- "$query" "$f" 2>/dev/null)
    [ "${hits:-0}" -eq 0 ] && continue
    id="${f##*/}"; id="${id%.jsonl}"
    meta=$(jq -Rr "$prog" "$f" 2>/dev/null)
    # The session name lives in custom-title/agent-name records inside the transcript,
    # not in the custom-title.json sidecar (which is absent for named sessions).
    title=$(printf '%s\n' "$meta" | grep '^T	' | tail -1 | cut -f2-)
    # Fall back to the opening prompt; strip the <command-message> markup slash commands add.
    [ -z "$title" ] && title=$(printf '%s\n' "$meta" | grep '^U	' | head -1 | cut -f2- \
      | sed -e 's/<[^>]*>/ /g' -e 's/  */ /g' -e 's/^ //')
    [ -z "$title" ] && title="(untitled)"
    title=$(printf '%s' "$title" | tr -d '|' | cut -c1-90)
    # Last user record, not the first: a resumed session carries its original cwd up front.
    cwd=$(printf '%s\n' "$meta" | grep '^C	' | tail -1 | cut -f2-)
    size=$(du -h "$f" | cut -f1 | tr -d ' ')
    mtime=$(date -r "$f" "+%b %d %H:%M")
    epoch=$(stat -f %m "$f" 2>/dev/null || echo 0)
    rows+="${epoch}|${hits}|${id}|${title}|${cwd}|${size}|${mtime}"$'\n'
  done
  eval "$nullglob_was"

  if [ "$bymtime" -eq 1 ]; then
    rows=$(printf '%s' "$rows" | grep . | sort -t'|' -k1,1rn)
  else
    rows=$(printf '%s' "$rows" | grep . | sort -t'|' -k2,2rn)
  fi
  if [ -z "$rows" ]; then
    echo "No sessions matching '${query}'."
    return 1
  fi

  if [ "$resume" -eq 1 ]; then
    local rid
    IFS='|' read -r _ _ rid _ _ _ _ <<< "$(printf '%s\n' "$rows" | sed -n "${pick}p")"
    if [ -z "$rid" ]; then
      echo "No match #${pick}."
      return 1
    fi
    echo "Resuming ${rid} in ${PWD}"
    claude -r "$rid"
    return
  fi

  local shown=0 total n=0
  total=$(printf '%s\n' "$rows" | wc -l | tr -d ' ')
  printf '%s session(s) matching %s — %s. "hits" = transcript lines containing the query.\n\n' \
    "$total" "'${query}'" "$([ "$bymtime" -eq 1 ] && echo 'newest first' || echo 'most hits first')"
  while IFS='|' read -r _ hits id title cwd size mtime; do
    [ "$shown" -ge "$limit" ] && break
    n=$((n + 1))
    printf '%2d) %s\n' "$n" "$title"
    if [ -z "$cwd" ]; then
      printf '    %s  %5s  %5s hits  cwd (unknown)\n' "$mtime" "$size" "$hits"
    elif [ ! -d "$cwd" ]; then
      printf '    %s  %5s  %5s hits  %s (gone)\n' "$mtime" "$size" "$hits" "${cwd/#$HOME/\~}"
    else
      printf '    %s  %5s  %5s hits  %s\n' "$mtime" "$size" "$hits" "${cwd/#$HOME/\~}"
    fi
    printf '    claude -r %s\n\n' "$id"
    shown=$((shown + 1))
  done <<< "$rows"
  if [ "$total" -gt "$shown" ]; then
    printf '... %s more match(es); narrow the query or pass --all.\n' "$((total - shown))"
  fi
}
